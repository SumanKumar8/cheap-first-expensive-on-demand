# ===== Only this project's real files are tracked =====
# Ignore everything at the project root, then re-include just the repo content.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CITATION.cff
!/repository/
!/Hierarchical-Model-SNN-main/
!/quantisenc-main_neuronid/

# Never track the quarantined raw data (~44 GB) or build/python junk
/_TO_DELETE/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
repository/results/_cache/

# stray probe files
.write_test
